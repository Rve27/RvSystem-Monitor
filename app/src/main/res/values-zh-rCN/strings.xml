    <string name="rust_method_desc_get_all_freq">获取所有在线 CPU 核心的当前时钟频率。</string>
    <string name="rust_method_desc_get_core_count">返回内核检测到的 CPU 核心总数。</string>
    <string name="rust_method_desc_get_core_freq">返回指定核心 ID 的特定频率类型（当前、最小、最大）。</string>
    <string name="rust_method_desc_get_governor">返回指定 CPU 核心当前使用的频率调节器。</string>
    <string name="rust_method_desc_get_cpu_temp">获取 CPU 封装/复合温度。</string>
    <string name="rust_method_desc_get_all_temps">返回每个 CPU 核心的温度数组。</string>
    <string name="rust_method_desc_get_dynamic">批量获取温度和频率，以便与界面同步。</string>
    <string name="rust_method_desc_calculate_load">解析 /proc/stat 字符串，通过与之前的状态比较计算总 CPU 和各核心的负载百分比。</string>

